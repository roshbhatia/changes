{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Diff": {
      "properties": {
        "difftool": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "engine": {
          "type": "string",
          "enum": [
            "builtin",
            "filter"
          ]
        },
        "filter": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "layout": {
          "type": "string",
          "enum": [
            "unified",
            "side-by-side"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$",
      "description": "Go duration such as 500ms, 10s, or 2m"
    },
    "Providers": {
      "properties": {
        "cacheMaxEntries": {
          "type": "integer",
          "minimum": 0
        },
        "cacheTtl": {
          "$ref": "#/$defs/Duration"
        },
        "directory": {
          "type": "string"
        },
        "timeout": {
          "$ref": "#/$defs/Duration"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "properties": {
    "color": {
      "type": "string",
      "enum": [
        "auto",
        "always",
        "never"
      ]
    },
    "diff": {
      "$ref": "#/$defs/Diff"
    },
    "providers": {
      "$ref": "#/$defs/Providers"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "Changes configuration"
}
