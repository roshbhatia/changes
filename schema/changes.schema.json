{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Diff": {
      "properties": {
        "difftool": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "engine": {
          "type": "string",
          "enum": [
            "builtin",
            "filter"
          ]
        },
        "filter": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "layout": {
          "type": "string",
          "enum": [
            "unified",
            "side-by-side"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Interactive": {
      "properties": {
        "cacheMaxEntries": {
          "type": "integer",
          "minimum": 0
        },
        "cacheTtl": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "dock": {
          "type": "string",
          "enum": [
            "left",
            "bottom"
          ]
        },
        "historyLimit": {
          "type": "integer",
          "minimum": 1
        },
        "navigator": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ]
        },
        "noteInput": {
          "type": "string",
          "enum": [
            "popup",
            "editor"
          ]
        },
        "progress": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "progress"
      ]
    },
    "Notes": {
      "properties": {
        "editor": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "generator": {
          "type": "string"
        },
        "generatorTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "store": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Providers": {
      "properties": {
        "cacheMaxEntries": {
          "type": "integer",
          "minimum": 0
        },
        "cacheTtl": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "directory": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "properties": {
    "color": {
      "type": "string",
      "enum": [
        "auto",
        "always",
        "never"
      ]
    },
    "diff": {
      "$ref": "#/$defs/Diff"
    },
    "interactive": {
      "$ref": "#/$defs/Interactive"
    },
    "notes": {
      "$ref": "#/$defs/Notes"
    },
    "providers": {
      "$ref": "#/$defs/Providers"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "Changes configuration"
}
