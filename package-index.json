      "binary": "changes-provider-github-pr",
      "description": "Replay an offline pull request review thread",
      "archive": "changes_provider_github-pr_%{version}_%{os}_%{arch}.tar.gz",
      "share": [
        "share/changes/providers/github-pr/provider.yaml"
      ],
      "python_script": false,
      "dependencies": [
        "gh",
        "git"
      ]
    },
    {
      "name": "changes-provider-local-notes",
      "kind": "provider",
      "binary": "changes-provider-local-notes",
      "description": "Keep a local note on prefix validation",
      "archive": "changes_provider_local-notes_%{version}_%{os}_%{arch}.tar.gz",
      "share": [
        "share/changes/providers/local-notes/provider.yaml"
      ],
